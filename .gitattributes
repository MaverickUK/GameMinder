# DOS source and data files keep their CRLF line endings on every platform,
# so they work as-is when copied to a DOS machine
*.[Pp][Aa][Ss] -text diff
*.[Ii][Nn][Cc] -text diff
*.[Aa][Ss][Mm] -text diff
*.[Tt][Xx][Tt] -text diff
*.[Bb][Aa][Tt] -text diff

*.[Tt][Pp][Uu] binary
*.[Ee][Xx][Ee] binary
*.jpg binary

*.sh text eol=lf
*.yml text eol=lf
